# Reserved for future integrations; the foundation does not read these variables.
# Copy to .env only when configuring integrations. Never commit real credentials.
GITHUB_TOKEN=replace-with-github-token
GOOGLE_CLOUD_PROJECT=replace-with-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=replace-with-vertex-ai-region
VERTEX_AI_MODEL=replace-with-gemini-model-id
# A local path to credentials, never the credential JSON itself.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/local/service-account-credentials.json
