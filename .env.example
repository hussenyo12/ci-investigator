# The collector reads GITHUB_TOKEN from the process environment, not from this file.
# Leave empty for public, unauthenticated collection. Export a real token securely
# only when needed; fine-grained tokens require Actions: read and Contents: read.
# Never commit real credentials. .env files are ignored and not loaded automatically.
GITHUB_TOKEN=

# Read from the process environment only when AI diagnosis is requested.
# Use ADC: gcloud auth application-default login, or an attached cloud identity.
# Do not configure API keys or service account JSON files.
# GOOGLE_APPLICATION_CREDENTIALS must be unset for this MVP.
GOOGLE_CLOUD_PROJECT=drivernets
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_MODEL=gemini-2.5-flash
# Per-request timeout, 1000..120000 milliseconds. Not a full authentication deadline.
VERTEX_AI_TIMEOUT_MS=60000
# Output-token ceiling, 512..8192. Incomplete output is rejected.
VERTEX_AI_MAX_OUTPUT_TOKENS=4096
