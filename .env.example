# The collector reads GITHUB_TOKEN from the process environment, not from this file.
# Leave empty for public, unauthenticated collection. Export a real token securely
# only when needed; fine-grained tokens require Actions: read and Contents: read.
# Never commit real credentials. .env files are ignored and not loaded automatically.
GITHUB_TOKEN=

# Reserved for future Vertex AI integration; not read by the current application.
GOOGLE_CLOUD_PROJECT=replace-with-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=replace-with-vertex-ai-region
VERTEX_AI_MODEL=replace-with-gemini-model-id
# A local path to credentials, never the credential JSON itself.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/local/service-account-credentials.json
